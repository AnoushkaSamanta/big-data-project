# PostgreSQL / PostGIS
POSTGRES_DB=ais
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ais_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only database user for frontend dashboard
DB_READ_USER=ais_read
DB_READ_PASSWORD=ais_read_password

# Apache Kafka (KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Frontend (Next.js)
PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Streaming / Detection configuration
SIMULATED_REPLAY_SPEEDUP=720
LATE_ARRIVAL_FRACTION=0.05
MAX_LATENESS_SECONDS=90
COVERAGE_MIN_OBSERVATIONS=500
SWEEPER_INTERVAL_SECONDS=60
DEDUP_WINDOW_HOURS=6

# Optional live AISStream.io API key (free at https://aisstream.io)
AISSTREAM_DATA_KEY=your_aisstream_api_key_here
